!input/README.md

# Output directories - exclude generated files
output/features/
output/vectorize/
output/model/
output/predictions/
output/logs/*.log

# Keep directory structure with .gitkeep files
!output/features/.gitkeep
!output/vectorize/.gitkeep
!output/model/.gitkeep
!output/predictions/.gitkeep
!output/logs/.gitkeep

# Example data - include sample data but not generated outputs
# Keep data directory structure and samples
!data/
!data/**
data/samples/*/
!data/samples/00/

